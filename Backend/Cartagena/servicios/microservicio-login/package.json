{
  "name": "microservicio-login",
  "version": "1.0.0",
  "description": "Microservicio de autenticacion y verificacion de identidad para el sistema de venta online",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:schema": "node scripts/crear-esquema.js",
    "db:usuario-app": "node scripts/crear-usuario-app.js",
    "db:usuarios": "node scripts/crear-usuarios.js",
    "db:demo": "node scripts/crear-usuarios.js",
    "db:reset": "node scripts/crear-esquema.js --reset && node scripts/crear-usuarios.js",
    "test": "node --test tests/"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.15.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
