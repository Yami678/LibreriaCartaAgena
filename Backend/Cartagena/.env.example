# Comparte una instancia MySQL existente. NO ejecutar otro MySQL automáticamente.
# DB_HOST/DB_PORT aplican cuando ejecutas los backends NATIVOS (./start-dev.sh).
# En Docker, docker-compose.yml fuerza DB_HOST=mysql y DB_PORT=3306 dentro de la red.
DB_HOST=localhost
DB_PORT=3307
DB_NAME=tienda_online
DB_USER=usuario_app
DB_PASSWORD=REEMPLAZAR_CON_CONTRASENA_MYSQL
# MISMA clave usada por microservicio-login e historial-compras.
JWT_SECRET=REEMPLAZAR_CON_OPENSSL_RAND_HEX_32
JWT_ISSUER=microservicio-login
JWT_EXPIRES_IN=15m
REQUIRE_EMAIL_VERIFICATION=false
RECAPTCHA_ENABLED=false
RECAPTCHA_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Origen del frontend en desarrollo (Vite). Vacío = no se habilita CORS.
CORS_ORIGIN=http://localhost:5173
# Puertos publicados en el host (modo Docker y Vite).
GATEWAY_PORT=8081
LOGIN_PORT=3000
DOTNET_PORT=8083
